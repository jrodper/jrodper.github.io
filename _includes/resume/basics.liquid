<div class="list-groups">
  <div class="col-md-4">
    {% assign image_path = data[1].image %} {% if image_path != "" %}
    <img
      src="{{ image_path | prepend: '/assets/img/' }}"
      alt="Profile Image"
      class="img-fluid z-depth-1 rounded-circle"
      style="max-height: 200px; margin-right: 30px; margin-bottom: 30px"
    />
    {% endif %}
  </div>

  <div class="col-md-8">
    <table
      class="table table-cv table-sm table-borderless table-responsive table-cv-map"
    >
      {% assign skip_basics = 'profiles,image' | split: ',' %} {% for content in
      data[1] %} {% if (content[1] == "") or (skip_basics contains content[0])
      %} {% continue %} {% endif %}

      <tr>
        <td class="p-1 pr-2 font-weight-bold">
          <b>{{ content[0] | capitalize }}</b>
        </td>
        <td class="p-1 pl-2 font-weight-light text">
          {% if content[0] == 'url' %}
          <a href="{{ content[1] }}" target="_blank" rel="noopener noreferrer"
            >{{ content[1] }}</a
          >
          {% elsif content[0] == 'email' %}
          <a href="mailto:{{ content[1] }}" target="_blank">{{ content[1] }}</a>
          {% elsif content[0] == 'phone' %}
          <a href="tel:{{ content[1] }}">{{ content[1] }}</a>
          {% elsif content[0] == 'location' %} {{ content[1].address }}, {{
          content[1].city }}, {{ content[1].region }} {{ content[1].postalCode
          }}, {{ content[1].countryCode }} {% else %} {{ content[1] }} {% endif
          %}
        </td>
      </tr>
      {% endfor %}
    </table>
  </div>
</div>
